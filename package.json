{
  "name": "@local/painted-animation-studio",
  "version": "1.3.0",
  "type": "module",
  "description": "A DSH-native studio for procedural hand-painted music videos, one-shot-per-line poetry, beat-synced short videos, and an optional local 3D video room.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/comlearner834/dsh-plugin-mv-studio.git"
  },
  "homepage": "https://github.com/comlearner834/dsh-plugin-mv-studio",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "music-video",
    "poetry",
    "animation",
    "3d",
    "blender"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/*.png",
    "tests",
    "skill"
  ],
  "scripts": {
    "test": "node tests/3d-tab.test.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
