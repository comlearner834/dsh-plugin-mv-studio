{
  "name": "painted-animation-project",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Procedural hand-painted animation template: p5.js + p5.brush + Puppeteer + ffmpeg.",
  "scripts": {
    "doctor": "node render.mjs doctor",
    "check": "node render.mjs check",
    "storyboard": "node render.mjs storyboard",
    "review": "node render.mjs review",
    "verdict": "node render.mjs verdict",
    "approve": "node render.mjs approve",
    "final": "node render.mjs final",
    "final-verdict": "node render.mjs final-verdict",
    "encode": "node render.mjs final --encode",
    "audio": "node tools/make-audio.mjs --out audio/long-way-home.wav --duration 12 --seed 7"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "p5": "2.3.4",
    "p5.brush": "3.0.0",
    "puppeteer-core": "25.16.0"
  }
}
